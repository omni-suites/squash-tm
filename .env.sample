# Squash TM — copy to .env and change passwords before public exposure
# Used by: docker-compose.yaml

# Postgres (service: squash-tm-pg)
DB_USERNAME=squashtm
DB_PASSWORD=change-me-squash-db
DB_DATABASE=squashtm

# Connection from Squash app → Postgres (Docker network DNS)
DB_TYPE=postgresql
DB_HOST=squash-tm-pg
DB_PORT=5432

# UI (host): http://localhost:8085